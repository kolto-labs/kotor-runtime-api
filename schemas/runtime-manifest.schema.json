{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeManifest",
  "description": "runtime-manifest.json, published with every runtime release. Unknown properties are allowed so minor releases can add optional fields.",
  "type": "object",
  "required": ["version", "protocol", "qualified", "files"],
  "properties": {
    "version": {
      "description": "Release version (semver).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "description": "Major of the runtime host protocol the release implements.",
      "type": "integer",
      "minimum": 1
    },
    "qualified": {
      "description": "Whether the release passed qualification.",
      "type": "boolean"
    },
    "files": {
      "description": "Every file in the release: wasm, JS, shell and archive chunks.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/File" }
    }
  },
  "$defs": {
    "File": {
      "type": "object",
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {
          "description": "File name, a single URL path segment.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the file contents.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "Size in bytes.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
